# Database (SQLite by default; switch to PostgreSQL by changing provider + url)
DATABASE_URL="file:./dev.db"

# Session signing secret — REQUIRED. Generate: openssl rand -base64 48
AUTH_SECRET=""

# Admin bootstrap (used by `npm run db:seed`)
ADMIN_EMAIL="admin@freefielder.ai"
ADMIN_PASSWORD=""

# --- AI providers (all optional; models activate only when their key is set) ---
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""
# https://fal.ai/dashboard/keys
FAL_KEY=""
# Optional API base overrides for self-hosted / proxy inference
REPLICATE_API_BASE="https://api.replicate.com"
FAL_API_BASE="https://queue.fal.run"

# LLM used for prompt-enhancement (optional; falls back to rule-based enhancer)
OPENAI_API_KEY=""

# --- Payments (optional; checkout disabled until configured) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Storage / CDN base where mirrored generation results are reachable (optional)
MEDIA_CDN_BASE=""
